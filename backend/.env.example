# --- SERVER CONFIG ---
PORT=5001
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# --- DATABASE ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/salon?retryWrites=true&w=majority

# --- SECURITY ---
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=your_very_strong_production_secret

# --- EMAIL (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
EMAIL_PASS=your-app-password
EMAIL_SECURE=false

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend.render.com/api/auth/google/callback
